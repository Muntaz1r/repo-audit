# Database Connection (Neon.tech or local Postgres; defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./repo_audit.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repo_audit

# Google AI Studio Gemini API Key (Primary Semantic Analysis Engine)
GEMINI_API_KEY=

# Groq Cloud API Key (Secondary Semantic Analysis Fallback Engine)
GROQ_API_KEY=

# Server Configuration
ENVIRONMENT=development
PORT=8000
MAX_REPO_SIZE_MB=100
AUDIT_TIMEOUT_SECONDS=60
WORKSPACE_DIR=
